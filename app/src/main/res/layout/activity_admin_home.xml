<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header with location icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:text="👑 Admin Dashboard"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>

            <ImageView
                android:id="@+id/btnStoreLocation"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_location"
                android:padding="4dp"
                android:contentDescription="Vị trí cửa hàng" />
        </LinearLayout>

        <!-- Manage Products -->
        <Button
            android:id="@+id/btnManageProducts"
            android:text="Quản lý sản phẩm"
            android:layout_marginBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="60dp"/>

        <!-- Manage Orders -->
        <FrameLayout
            android:id="@+id/layoutOrderBadge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp">

            <Button
                android:id="@+id/btnManageOrders"
                android:text="Quản lý đơn hàng"
                android:layout_width="match_parent"
                android:layout_height="60dp"/>
                
        </FrameLayout>

        <!-- Manage Users -->
        <Button
            android:id="@+id/btnManageUsers"
            android:text="Quản lý người dùng"
            android:layout_marginBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="60dp"/>

        <!-- Add Product -->
        <Button
            android:id="@+id/btnManageVouchers"
            android:text="Quản lý Voucher"
            android:layout_marginBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="60dp"/>

        <!-- Manage Feedbacks -->
        <Button
            android:id="@+id/btnManageFeedbacks"
            android:text="Quản lý đánh giá"
            android:layout_marginBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="60dp"/>

        <!-- Chat -->
        <FrameLayout
            android:id="@+id/layoutChatBadge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp">

            <Button
                android:id="@+id/btnChat"
                android:text="💬 Chat khách hàng"
                android:layout_width="match_parent"
                android:layout_height="60dp"/>

        </FrameLayout>

        <!-- Logout -->
        <Button
            android:id="@+id/btnLogout"
            android:text=" Đăng xuất"
            android:backgroundTint="#FF4444"
            android:textColor="#FFFFFF"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="60dp"/>

    </LinearLayout>

</ScrollView>