<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7FB">

    <!-- TOOLBAR -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:title="Voucher Details"
        android:titleTextColor="@android:color/white"
        android:backgroundTint="#FF5722"
        app:elevation="6dp"
        app:navigationIcon="?attr/homeAsUpIndicator"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- MAIN CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="10dp"
                app:cardElevation="10dp"
                app:strokeWidth="0dp"
                android:padding="30dp"
                android:backgroundTint="@android:color/white">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- CODE + STATUS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- ICON + CODE -->
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@android:drawable/ic_menu_agenda"
                                app:tint="#FF5722"
                                android:layout_marginEnd="6dp"/>

                            <TextView
                                android:id="@+id/tvCode"
                                android:text="SALE50"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="#FF5722"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <!-- STATUS -->
                        <LinearLayout
                            android:id="@+id/layoutStatus"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="5dp"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_active">

                            <ImageView
                                android:id="@+id/imgStatus"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@android:drawable/checkbox_on_background"
                                app:tint="@android:color/white"/>

                            <TextView
                                android:id="@+id/tvStatus"
                                android:text="ACTIVE"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="12sp"
                                android:layout_marginStart="4dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>

                    </LinearLayout>

                    <!-- DISCOUNT -->
                    <TextView
                        android:id="@+id/tvDiscountHighlight"
                        android:text="Giảm 50%"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#222"
                        android:layout_marginTop="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE"
                        android:layout_marginVertical="18dp"/>

                    <!-- INFO ROWS -->
                    <include
                        android:id="@+id/rowType"
                        layout="@layout/item_detail_row"/>

                    <include
                        android:id="@+id/rowValue"
                        layout="@layout/item_detail_row"/>

                    <include
                        android:id="@+id/rowMinOrder"
                        layout="@layout/item_detail_row"/>

                    <include
                        android:id="@+id/rowMaxUsage"
                        layout="@layout/item_detail_row"/>

                    <include
                        android:id="@+id/rowStart"
                        layout="@layout/item_detail_row"/>

                    <include
                        android:id="@+id/rowEnd"
                        layout="@layout/item_detail_row"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>