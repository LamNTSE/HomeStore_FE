<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#673AB7"
        app:title="Chi tiết người dùng"
        app:titleTextColor="#FFFFFF"
        app:navigationIcon="@drawable/ic_close"
        app:navigationIconTint="#FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Avatar -->
            <ImageView
                android:id="@+id/imgAvatar"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_avatar"
                android:background="@drawable/bg_avatar_circle"
                android:padding="8dp"
                android:layout_marginBottom="16dp"
                android:contentDescription="Avatar" />

            <!-- Info rows -->
            <include layout="@layout/item_detail_row"
                android:id="@+id/rowFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include layout="@layout/item_detail_row"
                android:id="@+id/rowEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include layout="@layout/item_detail_row"
                android:id="@+id/rowPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include layout="@layout/item_detail_row"
                android:id="@+id/rowAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include layout="@layout/item_detail_row"
                android:id="@+id/rowRole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include layout="@layout/item_detail_row"
                android:id="@+id/rowProvider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include layout="@layout/item_detail_row"
                android:id="@+id/rowCreatedAt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Edit button -->
            <Button
                android:id="@+id/btnEditUser"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="✏️ Chỉnh sửa"
                android:layout_marginTop="20dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
